# DS ATELIER backend configuration template.
# Copy to backend/.env and fill in local values. Never commit backend/.env.

DS_ATELIER_ENV=development

# Dedicated DS ATELIER development database only. Do not use a MoonAura database.
DS_ATELIER_DB_HOST=127.0.0.1
DS_ATELIER_DB_PORT=3306
DS_ATELIER_DB_NAME=ds_atelier_dev
DS_ATELIER_DB_USER=ds_atelier
DS_ATELIER_DB_PASS=change-me
DS_ATELIER_DB_CHARSET=utf8mb4

# Public site origin for later same-origin handlers. No trailing slash.
DS_ATELIER_APP_URL=http://localhost:8000

# Session cookie. Set DS_ATELIER_SESSION_SECURE=1 behind HTTPS.
DS_ATELIER_SESSION_NAME=ds_atelier_session
DS_ATELIER_SESSION_SECURE=0
DS_ATELIER_SESSION_SAMESITE=Lax

# Optional. Defaults to backend/storage/logs
# DS_ATELIER_LOG_PATH=

# Checkout shipping/tax live in backend/config/checkout.php.
# Development demo shipping is not a production policy. Tax is unconfigured by default.

# Transactional email. Never commit real credentials.
# Transport: disabled | test | smtp
# development defaults to test (does not send real email). production must use smtp or disabled.
DS_ATELIER_MAIL_TRANSPORT=test
DS_ATELIER_MAIL_FROM=
DS_ATELIER_MAIL_FROM_NAME=DS ATELIER
DS_ATELIER_MAIL_HOST=
DS_ATELIER_MAIL_PORT=587
DS_ATELIER_MAIL_ENCRYPTION=tls
DS_ATELIER_MAIL_USER=
DS_ATELIER_MAIL_PASS=
DS_ATELIER_MAIL_TIMEOUT=10

# Razorpay. Leave empty to keep orders pending payment. Never commit live keys.
# Key id is the public checkout key. Key secret and webhook secret stay on the server.
DS_ATELIER_RAZORPAY_KEY_ID=
DS_ATELIER_RAZORPAY_KEY_SECRET=
DS_ATELIER_RAZORPAY_WEBHOOK_SECRET=
DS_ATELIER_RAZORPAY_TIMEOUT=10
