# DS ATELIER backend configuration template.
# Copy to backend/.env and fill in local values. Never commit backend/.env.

DS_ATELIER_ENV=development

# Dedicated DS ATELIER development database only. Do not use a MoonAura database.
DS_ATELIER_DB_HOST=127.0.0.1
DS_ATELIER_DB_PORT=3306
DS_ATELIER_DB_NAME=ds_atelier_dev
DS_ATELIER_DB_USER=ds_atelier
DS_ATELIER_DB_PASS=change-me
DS_ATELIER_DB_CHARSET=utf8mb4

# Public site origin for later same-origin handlers. No trailing slash.
DS_ATELIER_APP_URL=http://localhost:8000

# Session cookie. Set DS_ATELIER_SESSION_SECURE=1 behind HTTPS.
DS_ATELIER_SESSION_NAME=ds_atelier_session
DS_ATELIER_SESSION_SECURE=0
DS_ATELIER_SESSION_SAMESITE=Lax

# Optional. Defaults to backend/storage/logs
# DS_ATELIER_LOG_PATH=
